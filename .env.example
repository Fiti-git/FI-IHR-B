# =========================
# IhrHub Backend (Django) — copy to .env and fill in
# =========================

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Database (local Postgres)
DB_NAME=ihrhubnew
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional — enable when email sending is wired up
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_USE_TLS=True

# Optional — S3 uploads (boto3 is installed but not configured yet)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
